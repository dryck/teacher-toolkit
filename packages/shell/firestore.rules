// Paste this into Firebase Console -> Firestore Database -> Rules -> Publish.
//
// One shared Firebase project backs every real-time tool in the toolkit.
// Each tool gets its own top-level collection, scoped so only that tool's
// expected fields/subcollections are readable or writable -- everything
// else is denied by the catch-all at the bottom. No student identity is
// ever required or stored; nicknames (Choice Board) and free text
// (Exit Ticket, Growth Mindset) are the only non-numeric fields, and
// none of them are linked to a real name, login, or device ID.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // TTL POLICY: Apply in Firebase Console -> Firestore -> Data -> (any collection)
    // Collection Settings -> Time-to-live (TTL) -> set to 30 days on 'createdAt' field
    // This ensures sessions auto-delete after 30 days for GDPR/privacy compliance.
    // Collections to enable: zonesSessions, exitTicketSessions, choiceBoardSessions, etc.
    // (All collections with createdAt field below)

    // Zones Check-In: unlike every other tool here, the session doc IS the
    // student-written data -- four counters bumped by FieldValue.increment --
    // so `update` cannot be owner-scoped without blocking every check-in.
    // Instead: only the owner creates and deletes, anyone signed in may move
    // the counters, and ownerUid/createdAt are immutable once set.
    match /zonesSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['blue', 'green', 'yellow', 'red', 'ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid
                   && (!('blue' in request.resource.data) || request.resource.data.blue is number)
                   && (!('green' in request.resource.data) || request.resource.data.green is number)
                   && (!('yellow' in request.resource.data) || request.resource.data.yellow is number)
                   && (!('red' in request.resource.data) || request.resource.data.red is number);
      allow update: if request.auth != null
                   && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['blue', 'green', 'yellow', 'red'])
                   && request.resource.data.ownerUid == resource.data.ownerUid
                   && request.resource.data.blue is number
                   && request.resource.data.green is number
                   && request.resource.data.yellow is number
                   && request.resource.data.red is number
                   && request.resource.data.blue >= 0
                   && request.resource.data.green >= 0
                   && request.resource.data.yellow >= 0
                   && request.resource.data.red >= 0;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Exit Ticket: a config doc (written once by the teacher when
    // generating a code) plus a responses subcollection (one doc per
    // student submission, students never read each other's responses
    // -- only the teacher's live dashboard reads the whole collection,
    // which these rules can't distinguish from a student, so reads are
    // open the same way they are for every other tool here).
    //
    // Three modes share this collection, distinguished by the config
    // doc's `mode` field ('ticket' | 'clearCloudy' | 'trafficLight';
    // absent/undefined means 'ticket', for sessions created before this
    // field existed). Config allowlist and response allowlist below are
    // each the union of every mode's fields -- individual field
    // correctness within a mode (e.g. `light` only ever being
    // red/yellow/green) is enforced client-side, same level of trust
    // this file already extends to every other collection here.
    match /exitTicketSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['mode', 'q1Enabled', 'q1Text', 'q2Enabled', 'q3Enabled', 'q3Text', 'ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                   && resource.data.ownerUid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['mode', 'q1Enabled', 'q1Text', 'q2Enabled', 'q3Enabled', 'q3Text', 'ownerUid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /responses/{responseId} {
        allow get, list: if true;
        // Free text with no length cap was the one unbounded field here: a
        // ~1MB answer renders straight onto the projected dashboard.
        allow create: if request.auth != null
                     && request.resource.data.keys().hasOnly(['q1Answer', 'confidence', 'q3Answer', 'clearText', 'cloudyText', 'light', 'submittedAt'])
                     && (!('q1Answer' in request.resource.data) || request.resource.data.q1Answer.size() <= 500)
                     && (!('q3Answer' in request.resource.data) || request.resource.data.q3Answer.size() <= 500)
                     && (!('clearText' in request.resource.data) || request.resource.data.clearText.size() <= 500)
                     && (!('cloudyText' in request.resource.data) || request.resource.data.cloudyText.size() <= 500);
        allow update, delete: if false;
      }
    }

    // Choice Board: a config doc (board layout, written by the teacher)
    // plus a per-student progress subcollection.
    match /choiceBoardSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      // createdAt added to the allowlist so the TTL policy has a field to
      // expire on; createSession() stamps it on every new session.
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['title', 'cells', 'mustDoMode', 'minRequired', 'ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                   && resource.data.ownerUid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['title', 'cells', 'mustDoMode', 'minRequired', 'ownerUid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /progress/{studentId} {
        allow get, list: if true;
        allow write: if request.auth != null
                     && request.resource.data.keys().hasOnly(['nickname', 'completed', 'joinedAt'])
                     && request.resource.data.nickname is string
                     && request.resource.data.nickname.size() <= 40;
      }
    }

    // Growth Mindset's "Wall of Yet": session doc stores ownerUid (teacher).
    // Entries start unapproved, and ONLY the teacher can flip `approved`
    // or delete a rejected one.
    match /growthWallSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /entries/{entryId} {
        allow read: if true;
        allow create: if request.auth != null
                     && request.resource.data.keys().hasOnly(['text', 'approved', 'createdAt'])
                     && request.resource.data.approved == false
                     && request.resource.data.text is string
                     && request.resource.data.text.size() <= 280;
        allow update: if request.auth != null
                     && get(/databases/$(database)/documents/growthWallSessions/$(sessionId)).data.ownerUid == request.auth.uid
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
        allow delete: if request.auth != null
                     && get(/databases/$(database)/documents/growthWallSessions/$(sessionId)).data.ownerUid == request.auth.uid;
      }
    }

    // Snowball Wall: a session doc the teacher writes (concept text, and
    // which of the 4 phases is active) plus a stickies subcollection --
    // students only ever create their own sticky, the teacher can update
    // (merge two stickies' text together) or delete (after a merge) any
    // sticky, but never create one themselves.
    match /snowballSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['concept', 'phase', 'ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid
                   && (!('phase' in request.resource.data) || request.resource.data.phase is number);
      allow update: if request.auth != null
                   && resource.data.ownerUid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['concept', 'phase', 'ownerUid', 'createdAt'])
                   && (!('phase' in request.resource.data) || request.resource.data.phase is number);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /stickies/{stickyId} {
        allow get, list: if true;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['text', 'phase', 'createdAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 140;
        // Merging two stickies is a teacher action, so both update and delete
        // are scoped to the session owner -- `delete: if true` previously let
        // any student wipe the class's work.
        allow update: if request.auth != null
                      && get(/databases/$(database)/documents/snowballSessions/$(sessionId)).data.ownerUid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 400;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/snowballSessions/$(sessionId)).data.ownerUid == request.auth.uid;
      }
    }

    // Challenge Deck: a config doc (deck title + categories, each with a
    // difficulty and a list of card strings) plus a per-student progress
    // subcollection, same shape as Choice Board's.
    match /challengeDeckSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      // createdAt added to the allowlist so the TTL policy has a field to
      // expire on; createSession() stamps it on every new session.
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['title', 'categories', 'ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                   && resource.data.ownerUid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['title', 'categories', 'ownerUid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /progress/{studentId} {
        allow get, list: if true;
        allow write: if request.auth != null
                     && request.resource.data.keys().hasOnly(['nickname', 'completedCardIds', 'joinedAt'])
                     && request.resource.data.nickname is string
                     && request.resource.data.nickname.size() <= 40
                     && request.resource.data.completedCardIds is list
                     && request.resource.data.completedCardIds.size() <= 200;
      }
    }

    // Chili Challenge: a config doc (task title + the three chili-level
    // task texts) plus a per-student choices subcollection -- a student's
    // choice is an upsert (they can change their mind), same shape as
    // Choice Board's progress subcollection.
    match /chiliChallengeSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['title', 'level1Text', 'level2Text', 'level3Text', 'ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                   && resource.data.ownerUid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['title', 'level1Text', 'level2Text', 'level3Text', 'ownerUid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /choices/{studentId} {
        allow get, list: if true;
        allow write: if request.auth != null
                     && request.resource.data.keys().hasOnly(['nickname', 'level', 'joinedAt'])
                     && request.resource.data.nickname is string
                     && request.resource.data.nickname.size() <= 40
                     && request.resource.data.level is number
                     && request.resource.data.level >= 1
                     && request.resource.data.level <= 3;
      }
    }

    // Help Ladder: only its "Ask 3 Before Me" mode touches Firestore (the
    // ladder-display mode is local-only). Config doc holds the 5 step
    // labels the student's reminder screen mirrors; the signals
    // subcollection is a fully anonymous per-student "I'm stuck" flag --
    // no nickname, ever -- that a student can also delete themselves to
    // cancel, and the teacher can bulk-delete via "Clear all".
    match /helpLadderSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['step1', 'step2', 'step3', 'step4', 'step5', 'ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                   && resource.data.ownerUid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['step1', 'step2', 'step3', 'step4', 'step5', 'ownerUid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /signals/{studentId} {
        allow get, list: if true;
        allow write: if request.auth != null
                     && request.resource.data.keys().hasOnly(['joinedAt']);
        // Known limitation: a signal doc is keyed by the localStorage
        // studentId, not by request.auth.uid, so the rules cannot tell "I am
        // cancelling my own signal" from "I am clearing someone else's".
        // Requiring auth removes drive-by deletion; a classmate can still
        // clear a flag. Keying signals by uid would close it properly.
        allow delete: if request.auth != null;
      }
    }

    // Brainstorm Timer: a config doc (the object being brainstormed,
    // duration, and a startedAt timestamp added once the teacher hits
    // "Start Thinking!") plus a fully anonymous ideas subcollection -- one
    // doc per submitted idea, no student identity, never edited or
    // deleted once created.
    match /brainstormSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['object', 'durationSeconds', 'ownerUid', 'createdAt', 'startedAt'])
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                   && resource.data.ownerUid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['object', 'durationSeconds', 'ownerUid', 'createdAt', 'startedAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /ideas/{ideaId} {
        allow get, list: if true;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['text', 'createdAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 100;
        allow update, delete: if false;
      }
    }

    // Peer Feedback: a session doc (the optional list of presenter/group
    // names, empty if feedback is untargeted) plus a fully anonymous
    // feedback subcollection -- one doc per submission, no student
    // identity, never edited or deleted once created.
    match /peerFeedbackSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['targets', 'ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                   && resource.data.ownerUid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['targets', 'ownerUid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /feedback/{feedbackId} {
        allow get, list: if true;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['target', 'stars', 'wish', 'createdAt'])
                      && request.resource.data.stars is list
                      && request.resource.data.stars.size() == 2
                      && request.resource.data.wish is string
                      && request.resource.data.wish.size() <= 150;
        allow update, delete: if false;
      }
    }

    // Live Quiz: a config+control doc (question set, plus which question
    // index is active and whether its answer is revealed -- written only
    // by the teacher) plus a players subcollection (nickname, upsert by
    // deterministic studentId, same shape as Choice Board's progress) and
    // a responses subcollection keyed by deterministic `studentId_questionIndex`
    // so a student changing their answer before reveal overwrites their own
    // doc instead of creating a duplicate. No score field is ever stored --
    // every client derives scores from responses + which questions are
    // revealed, the same trust level already extended to every other
    // collection in this file.
    match /liveQuizSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                   && request.resource.data.keys().hasOnly(['title', 'questions', 'currentQuestion', 'revealed', 'ownerUid', 'createdAt'])
                   && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                   && resource.data.ownerUid == request.auth.uid
                   && request.resource.data.keys().hasOnly(['title', 'questions', 'currentQuestion', 'revealed', 'ownerUid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /players/{studentId} {
        allow get, list: if true;
        allow write: if request.auth != null
                    && request.resource.data.keys().hasOnly(['nickname', 'joinedAt'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() <= 40;
      }

      match /responses/{responseId} {
        allow get, list: if true;
        allow write: if request.auth != null
                    && request.resource.data.keys().hasOnly(['studentId', 'questionIndex', 'optionIndex', 'createdAt'])
                    && request.resource.data.questionIndex is number
                    && request.resource.data.optionIndex is number;
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
